@import "../colors.rasi"

window {
    transparency: "real";
    width: 340px;
    location: center;
    anchor: center;
    border-radius: 28px;
    background-color: @surface;
    children: [ mainbox ];
}

mainbox {
    orientation: vertical;
    background-color: transparent;
    children: [ imagebox, listview ];
    spacing: 0px;
}

/* la imagen siempre se guarda en esta ruta fija (ver hyprshot.sh) */
imagebox {
    expand: true;
    height: 260px;
    background-color: @surface-container-low;
    border-radius: 28px 28px 0px 0px;
    background-image: url("/tmp/blacknode-screenshot/current.png", height);
}

/* barra inferior oscura con los botones circulares, solo íconos */
listview {
    expand: false;
    columns: 3;
    lines: 1;
    spacing: 14px;
    padding: 18px 24px;
    background-color: @surface-container-lowest;
    border-radius: 0px 0px 28px 28px;
}

element {
    background-color: @surface-container;
    text-color: @on-surface;
    border-radius: 100px;
    /* botones circulares: mismo alto y ancho */
    padding: 14px;
}

element selected {
    background-color: @primary;
    text-color: @on-primary;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    font: "JetBrains Mono Nerd Font 18";
}

element-icon {
    size: 0px;
}
