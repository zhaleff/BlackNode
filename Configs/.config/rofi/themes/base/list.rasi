configuration {
    show-icons: false;
}

window {
    transparency:     "real";
    location:         east;
    anchor:           east;
    width:            440px;
    border-radius:    28px 0px 0px 28px;
    padding:          0px;
    background-color: @surface;
}

mainbox {
    spacing:          12px;
    padding:          20px;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    spacing:          10px;
    padding:          16px 22px;
    background-color: @surface;
    text-color:       @on-surface;
    orientation:      horizontal;
    border-radius:    28px;
    border:           1.5px;
    border-color:     @outline-variant;
    children:         [ "entry" ];
}

entry {
    expand:          true;
    padding:         0px;
    background-color: transparent;
    text-color:      @on-surface;
    cursor:          text;
    placeholder:     "Search...";
    placeholder-color: @on-surface-variant;
    font:            "JetBrains Mono Nerd Font 14";
}

listview {
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          4px;
    padding:          4px 0px;
    border-radius:    28px;
    background-color: @surface;
    text-color:       @on-surface;
}

element {
    padding:          14px 18px;
    border-radius:    24px;
    background-color: transparent;
    text-color:       @on-surface;
    font:             "JetBrains Mono Nerd Font 13";
}

element selected {
    background-color: @secondary-container;
    text-color:       @on-secondary-container;
}

element selected.active {
    background-color: @primary-container;
    text-color:       @on-primary-container;
}

element active {
    text-color:       @primary;
}

element urgent {
    text-color:       @error;
}

element selected.urgent {
    background-color: @error-container;
    text-color:       @on-error-container;
}

element-text {
    padding:          4px 0px;
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
