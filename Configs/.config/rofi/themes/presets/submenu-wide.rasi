@import "~/.config/rofi/colors.rasi"

configuration {
    font:                        "JetBrainsMono Nerd Font 14";
    show-icons:                  true;
    display-drun:                " ";
    display-window:              " ";
    display-filebrowser:         " ";
}

window {
    width:                       560px;
    height:                      620px;
    transparency:                "real";
    border-radius:               24px;
    background-color:            @surface;
    location:                    center;
    anchor:                      center;
    border:                      1px;
}

mainbox {
    padding:                     24px;
    spacing:                     20px;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
    background-color:            transparent;
}

inputbar {
    spacing:                     0px;
    padding:                     0px;
    children:                    [ "entry" ];
    background-color:            transparent;
}

entry {
    background-color:            @surface-container-high;
    text-color:                  @on-surface;
    cursor:                      text;
    vertical-align:              0.5;
    placeholder-color:           @on-surface-variant;
    padding:                     14px 18px;
    border-radius:               14px;
}

listview {
    enabled:                     true;
    columns:                     1;
    spacing:                     6px;
    padding:                     0px;
    cycle:                       true;
    lines:                       8;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    background-color:            transparent;
    text-color:                  @on-surface;
}

element {
    spacing:                     0px;
    padding:                     12px 16px;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @on-surface;
    border-radius:               14px;
}

element selected.normal {
    background-color:            @primary;
    text-color:                  @on-primary;
}

element-icon {
    size:                        32px;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
    margin:                      0px 0px 0px 16px;
}

textbox {
    text-color:                  inherit;
    background-color:            inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
