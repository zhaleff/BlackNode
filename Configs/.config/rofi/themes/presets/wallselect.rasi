@import "~/.config/rofi/colors.rasi"

configuration {
    show-icons:          true;
    drun-display-format: "{name}";
    font:                "JetBrainsMono Nerd Font Bold 12";
}

window {
    width:                 100%;
    transparency:         "real";
    cursor:               "default";
    padding:              0px;
    location:             center;
    anchor:               center;
    border-radius:        32px;
    background-color:     transparent;
}

mainbox {
    children:            [ "listview" ];
    background-color:     @surface;
}

listview {
    columns:              5;
    lines:                1;
    spacing:              24px;
    padding:              20px 24px;
    cycle:                true;
    dynamic:              false;
    scrollbar:            false;
    layout:               vertical;
    fixed-height:         true;
    fixed-columns:        true;
    cursor:              "default";
    background-color:     transparent;
    text-color:           @on-surface;
}

element {
    padding:              -68px 0px -68px 0px;
    border-radius:        24px;
    cursor:               pointer;
    background-color:     @surface-container-high;
}

element selected.normal {
    background-color:     transparent;
    border:               2px;
    border-color:         @primary;
}

element-icon {
    size:                300px;
    cursor:              inherit;
    expand:              true;
    border-radius:       1px;
    background-color:    transparent;
    horizontal-align:    0.5;
    vertical-align:      0.5;
}


element-text {
    enabled:              false;
}

error-message {
    text-color:           @on-surface;
    background-color:     @surface;
    children:            [ "textbox" ];
}

textbox {
    text-color:           inherit;
    background-color:     inherit;
    vertical-align:       0.5;
    horizontal-align:     0.5;
}
