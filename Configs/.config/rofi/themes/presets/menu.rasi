@import "~/.config/rofi/colors.rasi"

configuration {
    font:                        "JetBrainsMono Nerd Font 13";
    show-icons:                  true;
    icon-theme:                  "Papirus-Dark";
    kb-row-tab:                  "";
}

window {
    width:                       660px;
    height:                      500px;
    transparency:                "real";
    fullscreen:                  false;
    border-radius:               24px 24px 0px 0px;
    background-color:            @surface;
    location:                    south;
    anchor:                      south;
    y-offset:                    0px;
}

mainbox {
    spacing:                     20px;
    padding:                     20px;
    orientation:                 vertical;
    children:                    ["listview",  "inputbar"  ];
    background-color:            transparent;
}

inputbar {
    spacing:                     0px;
    padding:                     0px;
    children:                    [ "entry" ];
    background-color:            transparent;
}

entry {
    background-color:            @surface;
    text-color:                  @on-surface;
    vertical-align:              0;
    placeholder:                 "Search...";
    placeholder-color:           @on-surface-variant;
    padding:                     6px;
    border-radius:                24px 0px 24px 16px;
    border:                       1px;
    border-color:                 @outline-variant;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       11;
    spacing:                     2px;
    padding:                     0px;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    background-color:            transparent;
    text-color:                  @on-surface;
}

element {
    spacing:                     0px;
    padding:                     11px 12px;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @on-surface;
    border-radius:                18px;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @on-surface-variant;
}

element selected.normal {
    background-color:            @primary;
    text-color:                  @on-primary;
}

element-icon {
    size:                         32px;
    cursor:                       inherit;
    background-color:             transparent;
    text-color:                   inherit;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
    margin:                      0px 0px 0px 12px;
    font:                        "JetBrainsMono Nerd Font 16";
}

textbox {
    text-color:                  inherit;
    background-color:            inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
