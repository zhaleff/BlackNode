@import "~/.config/rofi/colors.rasi"

configuration {
  modi:                        "drun,run";
  show-icons:                  true;
  display-drun:                " 󰀻 ";
  display-run:                 "  ";
  drun-display-format:         "{name}";
  window-format:               "{w}{t}";
  font:                        "JetBrainsMono Nerd Font 13";
  icon-theme:                  "Tela-circle-dracula";
  kb-row-tab:                  "";
}

window {
  height:                      510px;
  width:                       020px;
  transparency:                "real";
  border-radius:               32px;
  background-color:            @surface-container-low;
  padding:                     24px;
  location:                    north;
  anchor:                      north;
  y-offset:                    40px;
}

mainbox {
  spacing:                     0px;
  padding:                     0px;
  orientation:                 vertical;
  children:                    [ "inputbar", "listview" ];
  background-color:            transparent;
}

inputbar {
  spacing:                     0px;
  padding:                     0px;
  margin:                      0px 0px 20px 0px;
  background-color:            @surface-container-high;
  border-radius:               999px;
  children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
  expand:                      false;
  str:                         "󰀻";
  padding:                     12px 0px 12px 20px;
  background-color:            transparent;
  text-color:                  @on-surface-variant;
  vertical-align:              0.5;
  font:                        "feather 14";
}

entry {
  expand:                      true;
  padding:                     16px 20px;
  background-color:            transparent;
  text-color:                  @on-surface;
  cursor:                      text;
  placeholder:                 "Buscar aplicaciones...";
  placeholder-color:           @on-surface-variant;
  font:                        "JetBrainsMono Nerd Font 13";
}

listview {
  spacing:                     12px;
  padding:                     8px;
  columns:                     3;
  cycle:                       true;
  dynamic:                     true;
  scrollbar:                   false;
  layout:                      vertical;
  background-color:            transparent;
  text-color:                  @on-surface;
}

element {
  spacing:                     8px;
  padding:                     16px 10px;
  cursor:                      pointer;
  background-color:            transparent;
  text-color:                  @on-surface;
  border-radius:               999px;
  orientation:                 vertical;
}

element selected.normal {
  background-color:            @secondary-container;
  text-color:                  @on-secondary-container;
}

element-icon {
  size:                        40px;
  border-radius:               999px;
  background-color:            @surface-container-high;
  text-color:                  inherit;
  padding:                     6px;
}

element-text {
  enabled:                     true;
  font:                        "JetBrainsMono Nerd Font 11";
  vertical-align:              0.5;
  horizontal-align:            0.5;
}

error-message {
  text-color:                  @on-surface;
  background-color:            @surface;
  children:                    [ "textbox" ];
  border-radius:               999px;
  padding:                     12px 16px;
}

textbox {
  text-color:                  inherit;
  background-color:            inherit;
  vertical-align:              0.5;
  horizontal-align:            0.5;
}
