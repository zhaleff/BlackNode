[global]
    monitor = 0
    follow = none
    width = (320, 400)
    height = (0, 190)
    origin = top-right
    offset = "15x20"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    padding = 24
    horizontal_padding = 20
    text_icon_padding = 16
    icon_position = left
    min_icon_size = 44
    max_icon_size = 52
    icon_corner_radius = 12
    progress_bar = true
    progress_bar_height = 4
    progress_bar_min_width = 220
    progress_bar_max_width = 300
    progress_bar_corner_radius = 999
    progress_bar_corners = all
    progress_bar_frame_width = 0
    frame_width = 0
    separator_height = 0
    corner_radius = 16
    gap_size = 14
    line_height = 4
    notification_limit = 4
    idle_threshold = 120
    history_length = 50
    show_age_threshold = 60
    markup = full
    font = "JetBrains Mono Nerd Font Medium 10"
    format = "<b><span size='large'>%s</span></b>\n<span alpha='90%'>%b</span>"
    word_wrap = yes
    sort = yes
    shrink = no
    indicate_hidden = yes
    sticky_history = yes
    ignore_newline = no
    show_indicators = no
    stack_duplicates = true
    always_run_script = true
    hide_duplicate_count = false
    ignore_dbusclose = false
    force_xwayland = false
    mouse_left_click = do_action
    mouse_middle_click = close_all
    mouse_right_click = close_current
    browser = firefox
    progress_bar_color = "#ffb695"
    progress_bar_frame_color = "#1a120e"
[experimental]
    per_monitor_dpi = false
[urgency_low]
    background = "#1a120e"
    foreground = "#f1dfd8"
    highlight = "#ffb695"
    timeout = 4
[urgency_normal]
    background = "#1a120e"
    foreground = "#f1dfd8"
    highlight = "#ffb695"
    timeout = 6
[urgency_critical]
    background = "#1a120e"
    foreground = "#ffb4ab"
    highlight = "#ffb4ab"
    timeout = 0
