{
  "custom/music": {
    "format": "{}",
    "tooltip": true,
    "return-type": "json",
"exec": "~/.local/bin/blacknode/music show",
"on-click": "~/.local/bin/blacknode/music play-pause",
    "on-click-right": "~/.config/waybar/Scripts/music/now-playing.sh",
    "interval": 2,
    "max-length": 70
  }
}
