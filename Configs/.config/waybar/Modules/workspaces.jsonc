{
"hyprland/workspaces": {
    "format": "{name}",
    "on-click": "hyprctl dispatch workspace {name}",
    "all-outputs": true,
    "active-only": false,
    "format-icons": {
        "active": "󰮯",
        "default": "*",
        "urgent": "*"
    },
    "persistent-workspaces": {
        "*": 3
    }
}
}
