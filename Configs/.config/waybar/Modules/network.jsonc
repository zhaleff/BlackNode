{
"network": {
    "interval": 3,
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-linked": "󰈁  {ifname} (not IP)",
    "format-disconnected": "󰖪  Offline",
    "format-alt": "󰛳  {ifname}",
    "tooltip-format-wifi": "{icon}  {essid}\n  {ipaddr}/{cidr}\n󰓅  {signalStrength}% signal\n↓  {bandwidthDownBytes} ↑  {bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰈀  {ifname}\n{ipaddr}/{cidr}\nGateway: {gwaddr}",
    "tooltip-format-disconnected": "󰖪  Offline",
    "on-click": "~/.config/rofi/scripts/wifi.sh",
    "on-click-right": "nm-connection-editor",
    "format-icons": {
        "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "ethernet": ["󰈀"],
        "disconnected": ["󰖪"]
    }
}
}
