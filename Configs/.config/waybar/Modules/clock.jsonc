{
"clock": {
    "interval": 60,
    "format": "{:%I:%M %p}",
    "format-alt": "{:%A, %d %B}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "on-scroll": 1,
        "format": {
            "months": "<b>{}</b>",
            "days": "{}",
            "weekdays": "<b>{}</b>",
            "today": "<u><b>{}</b></u>"
        }
    },
    "actions": {
        "on-click": "mode",
        "on-click-right": "tz_up",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
    }

  }
}
