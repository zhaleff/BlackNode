{
  "include": [
    "~/.config/waybar/Modules/all_modules.jsonc"
  ],
  "modules-left": [
    "group/hollow-distro",
    "group/hollow-left-1",
    "group/hollow-left-3",
    "group/hollow-left-2"
  ],
  "modules-center": [
    "group/hollow-center-2",
    "group/hollow-center"

  ],
  "modules-right": [
    "group/hollow-right-4",
    "group/hollow-right-1",
    "group/hollow-right-2",
    "group/hollow-right-5",
    "group/hollow-right-3"
  ],
  "group/hollow-left-1": {
    "orientation": "horizontal",
    "modules": [ "hyprland/workspaces"]
  },
  "group/hollow-distro": {
    "orientation": "horizontal",
    "modules": [ "custom/distro"]
  },


  "group/hollow-right-2": {
    "orientation": "horizontal",
    "modules": ["mpris", "custom/nomusic", "custom/previous", "custom/pause", "custom/next"]
  },
  "group/hollow-right-1": {
    "orientation": "horizontal",
    "modules": [  "network", "custom/bluetooth",  "backlight","battery"]
  },
  "group/hollow-center": {
    "orientation": "horizontal",
    "modules": ["clock"]
  },
    "group/hollow-center-2": {
    "orientation": "horizontal",
    "modules": ["idle_inhibitor"]
  },
  "group/hollow-right-3": {
    "orientation": "horizontal",
    "modules": [ "custom/power"]
  },
  "group/hollow-right-5": {
    "orientation": "horizontal",
    "modules": [ "custom/weather"]
  },
  "group/hollow-left-3": {
    "orientation": "horizontal",
    "modules": ["custom/cam", "custom/mic", "custom/recording", "custom/dnd",  "wireplumber", "custom/pomodoro" ]
  },


  "group/hollow-left-2": {
    "orientation": "horizontal",
    "modules": ["custom/pacman", "custom/pkg-aur"]
  }
}
