#!/usr/bin/env bash
# BlackNode Persevere — struggle detection and companionship
# Detects long sessions with no visible progress, sends micro-step messages
set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/blacknode"
CACHE_MSGS="$CACHE_DIR/psych-messages.json"
REPO_MSGS="https://raw.githubusercontent.com/zhaleff/blacknode/main/Configs/.local/share/blacknode/psych-messages.json"
STATE_DIR="$HOME/.local/share/blacknode"
IDENTITY="$STATE_DIR/identity.json"
COOLDOWN_FILE="$STATE_DIR/psych/persevere_cooldown"
SESSION_START="$STATE_DIR/psych/session_start"
LAST_NOTIFIED="$STATE_DIR/psych/persevere_last_notified"
FOCUS_LOG="$STATE_DIR/psych/focus_log"
STRUGGLE_COUNT="$STATE_DIR/psych/struggle_count"
mkdir -p "$STATE_DIR/psych"

fetch_messages() {
  if [[ -f "$CACHE_MSGS" ]] && [[ $(($(date +%s) - $(stat -c %Y "$CACHE_MSGS" 2>/dev/null || echo 0))) -lt 3600 ]]; then
    cat "$CACHE_MSGS"; return
  fi
  curl -sf "$REPO_MSGS" -o "$CACHE_MSGS.tmp" && mv "$CACHE_MSGS.tmp" "$CACHE_MSGS" && cat "$CACHE_MSGS" || cat "$CACHE_MSGS" 2>/dev/null || echo '{}'
}

is_on_cooldown() {
  [[ -f "$COOLDOWN_FILE" ]] || return 1
  local elapsed=$(( $(date +%s) - $(cat "$COOLDOWN_FILE") ))
  [[ $elapsed -lt 5400 ]]  # 90 min cooldown per struggle session
}

set_cooldown() {
  date +%s > "$COOLDOWN_FILE"
}

detect_struggle_session() {
  local active_windows
  active_windows=$(hyprctl activewindow -j 2>/dev/null || echo '{}')
  local class
  class=$(echo "$active_windows" | python3 -c "import sys,json; print(json.load(sys.stdin).get('class',''))" 2>/dev/null || echo "")

  # Struggle candidates: editors, terminals (long sessions with low output)
  local struggle_classes="Alacritty kitty wezterm foot urxvt gnome-terminal Code code-oss neovim vim emacs idea phpstorm webstorm pycharm intellij"
  local is_struggle=false
  for c in $struggle_classes; do
    if [[ "$class" == "$c" ]]; then
      is_struggle=true
      break
    fi
  done

  $is_struggle || return 1

  # Check session duration
  if [[ ! -f "$SESSION_START" ]]; then
    date +%s > "$SESSION_START"
    return 1
  fi

  local session_start
  session_start=$(cat "$SESSION_START")
  local now
  now=$(date +%s)
  local elapsed=$((now - session_start))

  # Need at least 30 min to detect struggle
  [[ $elapsed -lt 1800 ]] && return 1

  # Check for low git activity or low file changes
  local git_activity=false
  local repo_path
  repo_path=$(find "$HOME" -name ".git" -maxdepth 4 -type d 2>/dev/null | head -5 | shuf -n1)
  if [[ -n "$repo_path" ]]; then
    repo_path=$(dirname "$repo_path")
    local recent_commits
    recent_commits=$(git -C "$repo_path" log --oneline --since="30 minutes ago" 2>/dev/null | wc -l)
    [[ $recent_commits -ge 1 ]] && git_activity=true
  fi

  # If there's git activity, less likely struggling
  if $git_activity; then
    # Reset timer if making progress
    date +%s > "$SESSION_START"
    return 1
  fi

  # Check for low diff activity in open projects
  local has_changes=false
  if [[ -n "$repo_path" ]]; then
    local changes
    changes=$(git -C "$repo_path" diff --stat 2>/dev/null | tail -1 | grep -oP '\d+' | head -1 || echo 0)
    [[ $changes -ge 5 ]] && has_changes=true
  fi

  if ! $has_changes; then
    # Increment struggle count
    local count=0
    [[ -f "$STRUGGLE_COUNT" ]] && count=$(cat "$STRUGGLE_COUNT")
    count=$((count + 1))
    echo "$count" > "$STRUGGLE_COUNT"

    # Need at least 2 consecutive struggle detections to trigger
    [[ $count -ge 2 ]] && return 0
  fi

  return 1
}

get_message() {
  local msgs=$1 section=$2
  echo "$msgs" | python3 -c "
import sys, json, random
try:
    d = json.load(sys.stdin)
    block = d.get('persevere', {})
    pool = block.get('$section', [])
    if isinstance(pool, list) and pool:
        print(random.choice(pool))
    elif isinstance(pool, dict):
        keys = list(pool.keys())
        if keys:
            sub = pool[random.choice(keys)]
            if isinstance(sub, list) and sub:
                print(random.choice(sub))
except: pass
"
}

get_late_night_message() {
  local msgs=$1 hour=$2
  echo "$msgs" | python3 -c "
import sys, json, random
try:
    d = json.load(sys.stdin)
    block = d.get('persevere', {}).get('late_night', {})
    for k in block:
        parts = k.split('-')
        lo, hi = int(parts[0]), int(parts[1])
        if lo <= $hour <= hi:
            pool = block[k]
            if isinstance(pool, list) and pool:
                print(random.choice(pool)); return
    # fallback to first
    for k in block:
        pool = block[k]
        if isinstance(pool, list) and pool:
            print(random.choice(pool)); return
except: pass
"
}

main() {
  local msgs
  msgs=$(fetch_messages)

  is_on_cooldown && exit 0

  # Check for late night detection (independent of struggle)
  local hour_utc
  hour_utc=$(date -u +%H)
  hour_utc=$((10#$hour_utc))

  local icon title body
  icon="$(bn-icon persevere-present)"

  if [[ $hour_utc -ge 22 ]] || [[ $hour_utc -le 5 ]]; then
    # Late night presence
    body=$(get_late_night_message "$msgs" "$hour_utc")
    if [[ -n "$body" ]]; then
      title="Late hours"
      dunstify -a "BlackNode" -i "$icon" -t 8000 "$title" "$body"
      set_cooldown
      exit 0
    fi
  fi

  # Try struggle detection
  if detect_struggle_session; then
    # Multiple message types alternating
    local section=""
    local roll=$((RANDOM % 100))
    if [[ $roll -lt 25 ]]; then
      section="presence"
      icon="$(bn-icon persevere-present)"
    elif [[ $roll -lt 50 ]]; then
      section="reframe"
      icon="$(bn-icon persevere-present)"
    elif [[ $roll -lt 75 ]]; then
      section="micro_step"
      icon="$(bn-icon persevere-step)"
    else
      # identity anchor — reference past success
      local closes streak
      closes=$(python3 -c "import json; print(json.load(open('$IDENTITY')).get('clean_closes',0))" 2>/dev/null || echo 0)
      streak=$(python3 -c "import json; print(json.load(open('$IDENTITY')).get('streak_current',0))" 2>/dev/null || echo 0)
      local anchor_msg
      anchor_msg=$(get_message "$msgs" "identity_anchor")
      anchor_msg="${anchor_msg//\{closes\}/$closes}"
      anchor_msg="${anchor_msg//\{streak\}/$streak}"
      dunstify -a "BlackNode" -i "$(bn-icon persevere-anchor)" -t 10000 "Remember who you are" "$anchor_msg"
      set_cooldown
      exit 0
    fi

    body=$(get_message "$msgs" "$section")
    if [[ -z "$body" ]]; then
      body="Keep going. I know you can."
    fi

    dunstify -a "BlackNode" -i "$icon" -t 8000 "I'm here" "$body"
    set_cooldown
    echo "0" > "$STRUGGLE_COUNT"
  fi
}

main "$@"