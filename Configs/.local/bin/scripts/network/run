#!/usr/bin/env bash
# ============================================================================
# Network module — WiFi management.
# First module written ON the hexagonal core: it consumes the same ports
# (bn_ui_select / bn_notify) instead of talking to rofi/dunst directly, so it
# automatically works under any adapter (rofi today, fzf in a tty session).
# ============================================================================
set -u

BN_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../blacknode" && pwd)"
export BN_ROOT BN_SCRIPTS="$BN_ROOT/../scripts"

# shellcheck source=../../blacknode/lib/bn-menu-core.sh
source "$BN_ROOT/lib/bn-menu-core.sh"
bn_load_adapter || exit 1

ROFI_SUB_THEME="${HOME}/.config/rofi/submenu.rasi"
PROMPT="Network"

wifi_enabled() {
    [[ "$(nmcli radio wifi)" == "enabled" ]]
}

notify_state() {
    bn_notify "Network" "$(nmcli radio wifi)"
}

current_ssid() {
    nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" {print $1; exit}'
}

password_prompt() {
    local ssid="$1"
    rofi -dmenu -password -p "Password: $ssid" -theme "$ROFI_SUB_THEME" 2>/dev/null
}

list_networks() {
    nmcli -g SSID,SIGNAL,SECURITY,IN-USE device wifi list --rescan yes 2>/dev/null \
        | awk -F: '
            $1 != "" && !seen[$1]++ {
                sec = ($3 == "" ? "open" : "sec")
                printf "%3d%%  %-4s %s\n", $2, sec, $1
            }' | sort -rn
}

connect() {
    wifi_enabled || { nmcli radio wifi on; sleep 2; }

    local pick ssid
    pick="$(printf '%s\n' "$(list_networks)" | bn_ui_select "$PROMPT")"
    [[ -z "$pick" ]] && return 0
    ssid="$(awk '{ $1=""; $2=""; sub(/^ +sec +|^ +open +/, ""); print }' <<<"$pick" | sed 's/^ *//')"

    if nmcli -g NAME connection show 2>/dev/null | grep -qxF "$ssid"; then
        nmcli connection up id "$ssid" >/dev/null 2>&1 \
            && bn_notify "Network" "Connected to $ssid" \
            || bn_notify "Network" "Failed to connect to $ssid"
        return 0
    fi

    local pass=""
    pass="$(password_prompt "$ssid")"
    if [[ -n "$pass" ]]; then
        nmcli device wifi connect "$ssid" password "$pass" >/dev/null 2>&1 \
            && bn_notify "Network" "Connected to $ssid" \
            || bn_notify "Network" "Failed: wrong password or out of range"
    else
        nmcli device wifi connect "$ssid" >/dev/null 2>&1 \
            && bn_notify "Network" "Connected to $ssid (open)" \
            || bn_notify "Network" "Failed to connect to $ssid"
    fi
}

known_networks() {
    local known sel
    known="$(nmcli -g NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" {print $1}' | sort)"
    [[ -z "$known" ]] && { bn_notify "Network" "No saved networks"; return 0; }
    sel="$(printf '%s\n' "$known" | bn_ui_select "$PROMPT: saved")"
    [[ -z "$sel" ]] && return 0
    nmcli connection up id "$sel" >/dev/null 2>&1 \
        && bn_notify "Network" "Connected to $sel" \
        || bn_notify "Network" "Could not connect to $sel"
}

disconnect() {
    local cur
    cur="$(current_ssid)"
    [[ -z "$cur" ]] && { bn_notify "Network" "No active WiFi"; return 0; }
    nmcli connection down id "$cur" >/dev/null 2>&1 && bn_notify "Network" "Disconnected from $cur"
}

toggle_wifi() {
    nmcli radio wifi toggle >/dev/null 2>&1
    notify_state
}

main() {
    local choice
    choice="$(printf '%s\n' \
        "Scan and Connect" \
        "Saved Networks" \
        "Disconnect" \
        "Toggle WiFi" \
        | bn_ui_select "$PROMPT")"
    case "$choice" in
        "Scan and Connect") connect ;;
        "Saved Networks")   known_networks ;;
        "Disconnect")       disconnect ;;
        "Toggle WiFi")      toggle_wifi ;;
    esac
}

main
