#!/usr/bin/env bash
exec python3 << 'BNPY'
import os, json, math, time, argparse, subprocess as sp
from datetime import datetime, timezone, timedelta

CACHE = os.path.expanduser("~/.cache/blacknode/solar_cache.json")
STATE = os.path.expanduser("~/.cache/blacknode/nightlight_state.json")

MIN_B = 0.15
MAX_B = 0.45

def locate():
    import urllib.request
    try:
        req = urllib.request.Request("https://ipapi.co/json/", headers={"User-Agent":"BlackNode/3.0"})
        with urllib.request.urlopen(req, timeout=10) as r:
            d = json.loads(r.read())
        return float(d.get("latitude", 40.41)), float(d.get("longitude", -3.70))
    except Exception:
        return 40.41, -3.70

def solar_elevation(dt, lat, lon):
    n = dt.timetuple().tm_yday
    t = dt.hour + dt.minute / 60.0 + dt.second / 3600.0
    M = math.radians((0.9856 * n - 3.289) % 360)
    C = 1.916 * math.sin(M) + 0.020 * math.sin(2 * M)
    L = math.radians((math.degrees(M) + C + 282.634) % 360)
    dec = math.asin(math.sin(L) * math.sin(math.radians(23.44)))
    HA = math.radians(15 * (t - 12) + lon)
    sin_alt = math.sin(math.radians(lat)) * math.sin(dec) + \
              math.cos(math.radians(lat)) * math.cos(dec) * math.cos(HA)
    return math.degrees(math.asin(max(-1, min(1, sin_alt))))

def brightness_from_elevation(elev):
    if elev >= 8.0:
        return MAX_B
    elif elev <= -4.0:
        return MIN_B
    t = (elev + 4.0) / 12.0
    t = t * t * (3.0 - 2.0 * t)
    return MIN_B + (MAX_B - MIN_B) * t

def get_current():
    r = sp.run(["brightnessctl", "get"], capture_output=True, text=True)
    m = sp.run(["brightnessctl", "max"], capture_output=True, text=True)
    try:
        return int(r.stdout.strip()) / max(1, int(m.stdout.strip()))
    except Exception:
        return 1.0

def set_brightness(level):
    pct = max(1, min(100, round(level * 100)))
    sp.run(["brightnessctl", "set", f"{pct}%"], capture_output=True)

def run(force=False):
    state = {}
    try:
        with open(STATE) as f:
            state = json.load(f)
    except Exception:
        pass

    lat = state.get("lat")
    lon = state.get("lon")
    if not lat or not lon:
        lat, lon = locate()
        state["lat"] = lat
        state["lon"] = lon

    now = datetime.now(timezone.utc)
    elev = solar_elevation(now, lat, lon)
    target = brightness_from_elevation(elev)
    current = get_current()

    if abs(target - current) >= 0.03 or force:
        steps = max(1, min(30, int(abs(target - current) / 0.025)))
        for i in range(steps):
            level = current + (target - current) * ((i + 1) / steps)
            set_brightness(level)
            time.sleep(0.08)

    state["elevation"] = round(elev, 2)
    state["brightness"] = round(target, 3)
    state["updated"] = now.isoformat()
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(state, f)

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--daemon", action="store_true")
    parser.add_argument("--once", action="store_true")
    args = parser.parse_args()

    if args.daemon:
        run(force=True)
        while True:
            time.sleep(60)
            run()
    elif args.once:
        run(force=True)
    else:
        run()
BNPY
