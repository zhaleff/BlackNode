#!/usr/bin/env bash
exec python3 << 'BNPY'
import sys, os, json, time, subprocess as sp
sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from datetime import datetime, timezone
from blacknode.resources import resolve
from blacknode.psyche.timing import utc_now

CACHE = os.path.expanduser("~/.cache/blacknode/solar_cache.json")
STATE = os.path.expanduser("~/.cache/blacknode/anticipate_state.json")

def locate():
    import urllib.request
    try:
        req = urllib.request.Request("https://ipapi.co/json/", headers={"User-Agent":"BlackNode/3.0"})
        with urllib.request.urlopen(req, timeout=10) as r:
            d = json.loads(r.read())
        return float(d.get("latitude",40.41)), float(d.get("longitude",-3.70))
    except: return 40.41, -3.70

def solar(lat, lon):
    import urllib.request
    now = time.time()
    if os.path.exists(CACHE) and now - os.path.getmtime(CACHE) < 3600:
        with open(CACHE) as f: return json.load(f)
    url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&daily=sunrise,sunset&timezone=UTC&forecast_days=1"
    try:
        req = urllib.request.Request(url, headers={"User-Agent":"BlackNode/3.0"})
        with urllib.request.urlopen(req, timeout=15) as r:
            data = json.loads(r.read())
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE, "w") as f: json.dump(data, f)
        return data
    except: return None

def bright(level):
    try: sp.run(["brightnessctl","set",f"{level}%"], capture_output=True)
    except: pass

def notify(title, body, urgency="normal", timeout=8000):
    icon = resolve("brightness","weather-clear")
    sp.run(["dunstify","-a","System","-u",urgency,"-t",str(timeout),"-i",icon,"-r","2603",title,body])

def run():
    lat, lon = locate()
    data = solar(lat, lon)
    if not data: return

    daily = data.get("daily", {})
    rises = daily.get("sunrise", [])
    sets = daily.get("sunset", [])
    if not rises or not sets: return

    now = utc_now()
    rise = datetime.fromisoformat(rises[0].replace("Z","+00:00"))
    set_ = datetime.fromisoformat(sets[0].replace("Z","+00:00"))

    fired = {}
    try:
        with open(STATE) as f: fired = json.load(f)
    except: fired = {}

    today = now.strftime("%Y-%m-%d")
    changed = False

    mins_to_sunset = int((set_ - now).total_seconds() / 60)
    mins_to_sunrise = int((rise - now).total_seconds() / 60)

    if 15 <= mins_to_sunset <= 30 and not fired.get(f"{today}_sunset"):
        notify("Sunset approaching",
               f"It'll get dark in about {mins_to_sunset} min. Adjusting screen.")
        bright(40)
        fired[f"{today}_sunset"] = True; changed = True

    if 15 <= mins_to_sunrise <= 30 and not fired.get(f"{today}_sunrise"):
        notify("Sunrise approaching",
               f"Morning light in about {mins_to_sunrise} min. Restoring brightness.")
        bright(80)
        fired[f"{today}_sunrise"] = True; changed = True

    from blacknode.psyche.timing import CircadianClock
    cc = CircadianClock()
    period = cc.current_period()
    if period == "evening" and 0 < mins_to_sunset < 15 and not fired.get(f"{today}_dusk"):
        bright(40)
        fired[f"{today}_dusk"] = True; changed = True
    if period == "dawn" and 0 < mins_to_sunrise < 15 and not fired.get(f"{today}_dawn"):
        bright(80)
        fired[f"{today}_dawn"] = True; changed = True

    if changed:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE, "w") as f: json.dump(fired, f)

import argparse
parser = argparse.ArgumentParser()
parser.add_argument("--daemon", action="store_true")
args = parser.parse_args()

if args.daemon:
    while True:
        run()
        time.sleep(300)
else:
    run()
BNPY