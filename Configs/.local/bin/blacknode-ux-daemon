#!/bin/bash
# BlackNode UX Daemon wrapper
# Usage: blacknode-ux-daemon {start|stop|status|test}

DAEMON_SCRIPT="$HOME/.local/ux/daemon.py"
PID_FILE="$HOME/.local/state/blacknode/ux-daemon.pid"

case "${1:-help}" in
    start)
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo "daemon already running (pid $(cat "$PID_FILE"))"
            exit 0
        fi
        mkdir -p "$(dirname "$PID_FILE")"
        python3 "$DAEMON_SCRIPT" start &
        echo $! > "$PID_FILE"
        echo "daemon started (pid $!)"
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            kill "$(cat "$PID_FILE")" 2>/dev/null
            rm -f "$PID_FILE"
            echo "daemon stopped"
        else
            echo "daemon not running"
        fi
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        python3 "$DAEMON_SCRIPT" status
        ;;
    test)
        python3 "$DAEMON_SCRIPT" test "${@:2}"
        ;;
    *)
        echo "usage: blacknode-ux-daemon {start|stop|restart|status|test}"
        exit 1
        ;;
esac
