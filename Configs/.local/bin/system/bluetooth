#!/usr/bin/env bash
exec python3 << 'BNPY'
import sys, os, signal, subprocess, re, time
sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from blacknode.resources import resolve
from blacknode.notify.envelope import NotificationEnvelope

signal.signal(signal.SIGTERM, lambda *_: exit(0))
signal.signal(signal.SIGINT, lambda *_: exit(0))

def connected_devices():
    out = subprocess.run(["bluetoothctl","devices","Connected"], capture_output=True, text=True, timeout=10).stdout
    names = []
    for line in out.splitlines():
        m = re.match(r"Device\s+([0-9A-F:]+)\s+(.+)", line, re.I)
        if m: names.append(m.group(2).strip())
    return names

prev = set(connected_devices())

while True:
    now = set(connected_devices())
    new = now - prev
    gone = prev - now
    for d in new:
        envelope = NotificationEnvelope(
            title="Ready",
            body=f"Your {d} is ready.",
            icon=resolve("bluetooth","device"),
            urgency="low", timeout=4000, replace_id=2602, app_name="Bluetooth",
        )
        subprocess.run(["dunstify","-a",envelope.app_name,"-u",envelope.urgency,
                        "-t",str(envelope.timeout),"-i",envelope.icon,
                        "-r",str(envelope.replace_id),envelope.title,envelope.body])
    for d in gone:
        envelope = NotificationEnvelope(
            title="Disconnected",
            body=f"{d} disconnected.",
            icon=resolve("bluetooth","device"),
            urgency="low", timeout=3000, replace_id=2602, app_name="Bluetooth",
        )
        subprocess.run(["dunstify","-a",envelope.app_name,"-u",envelope.urgency,
                        "-t",str(envelope.timeout),"-i",envelope.icon,
                        "-r",str(envelope.replace_id),envelope.title,envelope.body])
    prev = now
    time.sleep(5)
BNPY